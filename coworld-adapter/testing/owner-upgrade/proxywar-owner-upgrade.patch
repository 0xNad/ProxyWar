+    cwd: HERE,
+    env: {
+      ...process.env,
+      COWORLD_PLAYER_WS_URL: url,
+      AWS_REGION: "us-east-1",
+      AWS_EC2_METADATA_DISABLED: "true",
+      BEDROCK_MODEL: "owner-contract-no-provider-call",
+    },
+    stdio: ["ignore", "pipe", "pipe"],
+  });
