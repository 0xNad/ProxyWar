+ * action id, or rewrites authored message text.
+ */
+
+export const OWNER_MESSAGE_MAX_CHARS = 280;
+export const OWNER_SPATIAL_SERIALIZED_MAX_BYTES = 16 * 1024;
+export const OWNER_MINIMAP_SERIALIZED_MAX_BYTES = 2 * 1024;
