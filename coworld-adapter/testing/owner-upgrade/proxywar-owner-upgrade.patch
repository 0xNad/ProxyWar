+            legend: [],
+          },
+        },
+      },
+      legalActions: [
+        holdAction(),
+        {
+          id: `deal_accept:${dealID}`,
+          kind: "deal_accept",
+          label: "Accept Rival B's non-aggression pact",
+          risk: { level: "medium", score: 0.35 },
+          metadata: {
+            dealID,
+            recipientID: "P_B",
