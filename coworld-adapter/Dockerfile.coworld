FROM --platform=$TARGETPLATFORM node:24-bookworm-slim

ENV GAME_ENV=dev
ENV HUSKY=0
ENV PROXYWAR_REPO=/app/proxywar
# This image IS the league package: build the client with every
# betting/wagering surface excluded (vite.config.ts aliases the wagering
# module graph to inert stubs and hard-fails if any wagering module loads).
# Operator boundary 2026-07-27: speculation lives only on the separate bet
# surface, never inside the league. beta/bet deployments build without this
# env and are unaffected.
ENV PROXYWAR_LEAGUE_CLIENT=1

WORKDIR /app/proxywar
COPY proxywar/package.json proxywar/package-lock.json ./
RUN npm ci --ignore-scripts
COPY proxywar/ ./
RUN npm run build-prod
# Mechanical proof on the exact assets this package ships: fail the image
# build if the wagering build sentinel appears anywhere in static/. The
# inverse self-test (a NORMAL build must CONTAIN the sentinel, so this scan
# can never pass because the sentinel rotted) runs host-side in the
# build:image chain via `npm run verify:league-client`.
RUN node scripts/scan-wagering-sentinel.mjs --expect absent --dir static

WORKDIR /app/integration
COPY integration/package.json integration/package-lock.json ./
RUN npm ci --ignore-scripts
COPY integration/ ./

WORKDIR /app/proxywar
# Use the tsx LOADER (node --import tsx/esm), NOT the tsx CLI. The CLI spawns an
# IPC server socket under /tmp (tsx-<n>/<n>.pipe); on a read-only root filesystem
# (how Coworld/k8s hardens episode pods) that listen() fails with EROFS and the
# container exits 1 before any app output. The loader needs no writable /tmp.
# Cap the V8 heap: Node sizes its default old-space from HOST memory, not the
# pod's cgroup limit, so a long episode lets garbage accumulate until the kernel
# OOM-kills the pod (exit 137 -> the hosted "game_error"). 640MB forces full GCs
# well inside a 1GB episode pod; the episode's live set stays ~400-500MB.
CMD ["node", "--max-old-space-size=640", "--import", "tsx/esm", "/app/integration/src/no-docker-coworld-episode.ts"]
