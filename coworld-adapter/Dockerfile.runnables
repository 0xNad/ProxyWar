FROM --platform=$TARGETPLATFORM node:24-bookworm-slim@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03

ENV PROXYWAR_REPO=/app/integration \
    NODE_ENV=production

WORKDIR /app/integration
COPY runnables/package.json runnables/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts \
    && npm cache clean --force

COPY src/starter-player.mjs src/coworld-url.mjs src/proxywar-optimizer-plan.mjs ./src/

CMD ["node", "/app/integration/src/starter-player.mjs"]
