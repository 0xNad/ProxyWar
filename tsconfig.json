// https://www.typescriptlang.org/tsconfig/
{
  "compilerOptions": {
    // Language and Environment
    "target": "ES2020",
    // ES2022 lib enables Error `cause` (ErrorOptions) for incident-preserving
    // rethrows; the emit target stays ES2020. Node 24 + modern browsers support
    // the runtime APIs, and no code uses importScripts/ScriptHost (the dropped
    // es2020.full libs), verified before narrowing.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Modules
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "resources/*": ["./resources/*"],
      "src/*": ["./src/*"]
    },
    // Emit
    "sourceMap": true,
    // Type Checking
    "allowUnusedLabels": false,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "useDefineForClassFields": false,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "src/**/*",
    "resources/**/*",
    "proprietary/**/*",
    "generated/**/*",
    "tests/**/*",
    "src/scripts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules"]
}
