<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.proxywar.platform</string>

  <!-- The platform account origin (proxywar.xyz apex, port 8793): sole account
       and session authority, independent of Coworld generation. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/YOUR_USER/Library/Application Support/ProxyWar/bin/start-proxywar-platform.zsh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USER/Library/Application Support/ProxyWar/bin</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/YOUR_USER/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/YOUR_USER</string>
    <!-- Platform and league origin must read the SAME generated league
         mirror; point this at the canonical repo's artifacts dir, not a
         private per-origin copy. -->
    <key>PROXYWAR_ARTIFACTS_ROOT</key>
    <string>/Users/YOUR_USER/Documents/proxywar_main/artifacts</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>/tmp/pw-platform.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/pw-platform.log</string>
</dict>
</plist>
