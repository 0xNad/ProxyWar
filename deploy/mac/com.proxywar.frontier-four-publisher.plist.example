<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.proxywar.frontier-four-publisher</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/YOUR_USER/Library/Application Support/ProxyWar/bin/start-proxywar-frontier-four-publisher.zsh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/YOUR_USER</string>
    <key>PATH</key>
    <string>/Users/YOUR_USER/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PROXYWAR_PROJECT_DIR</key>
    <string>/Users/YOUR_USER/Documents/ProxyWar</string>
    <key>PROXYWAR_ARTIFACTS_ROOT</key>
    <string>/Volumes/YOUR_VOLUME/ProxyWar/live-artifacts</string>
  </dict>
  <!--
    One run per invocation, every minute; it exits at once while the games
    file is unchanged. zsh is the program and node does the work, the shape
    of the league mirror, so that the scheduler's Python never touches a
    volume (see docs/PROXYWAR_FRONTIER_FOUR.md). Do NOT set KeepAlive.
  -->
  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USER/Documents/ProxyWar</string>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USER/Library/Logs/proxywar-frontier-four-publisher.err.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USER/Library/Logs/proxywar-frontier-four-publisher.err.log</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
</dict>
</plist>
