<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.proxywar.premiere-loop</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/YOUR_USER/Library/Application Support/ProxyWar/bin/start-proxywar-premiere-loop.zsh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/YOUR_USER/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>PROXYWAR_PROJECT_DIR</key>
    <string>/Users/YOUR_USER/Documents/ProxyWar</string>
    <key>PROXYWAR_ENV_FILE</key>
    <string>/Users/YOUR_USER/.proxywar/proxywar-beta.env</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USER/Documents/ProxyWar</string>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USER/Library/Logs/proxywar-premiere-loop.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USER/Library/Logs/proxywar-premiere-loop.err.log</string>
  <!--
    One iteration per invocation. StartInterval fires every 60s; launchd will
    not start a second instance while a prior (restart-bearing) iteration is
    still running, and the loop also takes its own single-instance lock. Do NOT
    set KeepAlive — the loop is not a daemon.

    IMPORTANT: uuencode/deploy this with the loop pointed at a retention-pin
    manifest OUTSIDE the byte-frozen release checkout. Set, in the env file,
    PROXYWAR_LEAGUE_RETENTION_PINS=/absolute/writable/path/coworld-league-retention-pins.json
    for BOTH the league mirror and this loop, seeded with the current pins, so
    the loop's runtime pin writes never dirty the frozen tree or trip the
    controlled-generation clean-tree provenance gate.
  -->
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>AbandonProcessGroup</key>
  <false/>
  <key>ExitTimeOut</key>
  <integer>30</integer>
</dict>
</plist>
